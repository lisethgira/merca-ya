{
  "installCommand": "npm install --prefix frontend-merca-ya && npm install --prefix backend-merca-ya",
  "buildCommand": "npm run build --prefix frontend-merca-ya",
  "outputDirectory": "frontend-merca-ya/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
