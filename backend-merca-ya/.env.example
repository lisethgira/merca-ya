# Copia este archivo a .env y pega las credenciales del add-on MySQL de Clever Cloud.
# En el panel aparecen como MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_USER,
# MYSQL_ADDON_PASSWORD y MYSQL_ADDON_DB. Puedes usar esos nombres o los DB_* de abajo.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# El plan pequeño de Clever Cloud admite como máximo 5 conexiones a la vez.
DB_CONNECTION_LIMIT=3

PORT=4000
NODE_ENV=development
# Orígenes del frontend separados por coma. En Vercel agrega también la URL pública del frontend.
FRONTEND_URL=http://localhost:5173

# Claves para firmar los JWT. Cámbialas antes de desplegar.
JWT_ACCESS_SECRET=cambia-esta-clave-access
JWT_REFRESH_SECRET=cambia-esta-clave-refresh

# demo: los pagos en línea se aprueban sin pasarela (no se guardan tarjetas).
# wompi: deja el pago pendiente hasta conectar la pasarela.
PAYMENT_MODE=demo
ENVIO_BASE=8000
ENVIO_GRATIS_DESDE=150000

# Opcional. Sin SMTP, en desarrollo el enlace de recuperación se imprime en la consola del API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MercaYa <no-reply@mercaya.com>

# Opcional. Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mercaya.com
